/**
 * The knight's head and neck: the one asymmetric silhouette in the set.
 *
 * The body traces a single closed path: chest bottom-left → up the breast →
 * muzzle extends forward-left → jaw turns up → forehead rises to the rounded
 * crown → back of head descends → neck crest sweeps down → closes at
 * chest bottom-right. The crown is deliberately smooth here so the separate
 * ear can rise from it cleanly as a pointed spike rather than a kink in the
 * outline.
 */
const KNIGHT_HEAD =
  // Breast: chest left, rising to shoulder height
  'M30 77 C29 64 33 54 41 49' +
  // Jaw: muzzle protrudes forward-left, jaw turns to face the chin
  ' C34 47 27 43 23 39 C20 36 21 32 25 29' +
  // Forehead: rises from eye area to the rounded crown
  ' C29 24 37 17 45 12 C46 9 47 6 46 5' +
  // Back of head: cross the crown and descend the poll
  ' C51 5 57 10 61 16' +
  // Neck: crest sweeps down and back to the chest right
  ' C68 27 72 43 72 57 C72 66 71 73 70 77 Z';

